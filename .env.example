# Variables NEXT_PUBLIC_* se hornean en el bundle del cliente al hacer next build.
# Para correr local:  copia este archivo a .env.local y rellena los valores.
# .env.local esta gitignored.

# OAuth (mismo Client ID en dev y prod)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# URLs de los 7 servicios backend desplegados en Cloud Run
# Apunta a los -dev cuando trabajas en local contra el ambiente de desarrollo.
NEXT_PUBLIC_API_LOGIN_URL=
NEXT_PUBLIC_API_ESTUDIOS_URL=
NEXT_PUBLIC_API_INGESTION_URL=
NEXT_PUBLIC_API_CLASIFICADOR_URL=
NEXT_PUBLIC_API_DOCUMENTOS_URL=
NEXT_PUBLIC_API_SINTETIZADOR_URL=
NEXT_PUBLIC_API_VERIFICACION_URL=

# 'dev' o 'prod'. Util para mostrar banners de ambiente.
NEXT_PUBLIC_HIPOTECAI_ENV=dev

NODE_ENV=development
